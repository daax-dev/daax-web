[Unit]
Description=Relay the daax Docker network to agentd's loopback listener
After=agentd.service
Wants=agentd.service
# The bridge does not exist until docker has created the external daax-net, so
# the first starts after a boot are expected to fail. Restart without a rate
# limit rather than ordering on something this unit cannot see.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/agentd-docker-relay
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
